# ==============================================================================
# CONFIGURACION DEL SISTEMA - CONSULTORIO PSICOLOGICO
# ==============================================================================
# Copia este archivo como .env y edita las variables segun tu entorno.

# Clave secreta para la sesion de Flask (genera una cadena segura y aleatoria en produccion)
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion_xyz123

# Entorno de ejecucion: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=True

# Puerto del servidor
PORT=3000

# Ruta de la base de datos SQLite (opcional, por defecto database.sqlite en la raiz)
# DB_PATH=database.sqlite

# ------------------------------------------------------------------------------
# SERVICIO DE CORREO ELECTRONICO (SMTP - Notificaciones de confirmacion de citas)
# Si se dejan en blanco, el sistema operara en modo SIMULACION (imprime en consola).
# ------------------------------------------------------------------------------
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion_gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ------------------------------------------------------------------------------
# DATOS DE LA CONSULTORIA / PROFESIONAL (Utilizados en correos y plantillas)
# ------------------------------------------------------------------------------
CLINIC_NAME=Zumaikira Bailey Psicologa
CLINIC_TITLE=PSICOLOGA - C.I.P. 8362
CLINIC_PHONE=+507 6235-281
CLINIC_EMAIL=Zumaikirabailey98@gmail.com
CLINIC_ADDRESS=Atlantic Plaza, 1er piso, local 127, oficina #224
