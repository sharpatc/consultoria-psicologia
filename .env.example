# Copia este archivo como .env y define valores seguros antes de iniciar Docker.

# Genera la clave secreta con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Puerto local; para internet se usa Caddy en 80/443.
APP_PORT=3000
SESSION_COOKIE_SECURE=false

# Correo SMTP opcional (sin configurar, el sistema simula el envío).
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
TIMEZONE=America/Panama
APPOINTMENT_REMINDER_HOUR=8
APPOINTMENT_REMINDER_MAX_ATTEMPTS=4
APPOINTMENT_REMINDER_RETRY_MINUTES=15

# Obligatorio para el perfil internet: DNS apuntando al servidor.
DOMAIN=
ACME_EMAIL=

CLINIC_NAME=PsicoEmocional
CLINIC_TITLE=Psicologia y bienestar emocional
CLINIC_PHONE=+507 6235-281
CLINIC_EMAIL=Zumaikirabailey98@gmail.com
CLINIC_ADDRESS=Atlantic Plaza, 1er piso, local 127, oficina #224
